# WHOOP developer app (required for every mode)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Local CLI sign-in (whoop-sleep-mcp auth). Must match the WHOOP dashboard.
# WHOOP_REDIRECT_URI=http://localhost:8787/callback
# WHOOP_TOKEN_FILE=

# Hosted multi-user (MCP_MODE=hosted). Redirect URI becomes $PUBLIC_URL/callback
# MCP_TRANSPORT=http
# MCP_MODE=hosted
# TOKEN_ENCRYPTION_KEY=
# PUBLIC_URL=https://your-service.onrender.com
# DATA_DIR=/var/data

# Single-user HTTP (shared bearer; not for multiple people)
# MCP_TRANSPORT=http
# MCP_AUTH_TOKEN=
# PORT=3000
