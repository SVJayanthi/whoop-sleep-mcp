diff --git a/src/tools/v2/sleep_hr.ts b/src/tools/v2/sleep_hr.ts
new file mode 100644
index 0000000..3a57847
--- /dev/null
+++ b/src/tools/v2/sleep_hr.ts
@@ -0,0 +1,19 @@
+import { z } from "zod";
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import type { WhoopClient } from "../../whoop/client.js";
+import { projectSleepHr } from "../../projections/sleep_hr.js";
+import { jsonOut } from "../../whoop/json_out.js";
+import { todayIso } from "../../lib/dates.js";
+
+export function registerSleepHr(server: McpServer, client: WhoopClient): void {
+  server.tool(
+    "whoop_sleep_hr",
+    "Heart rate around last night's sleep, from the in-sleep HR curve: in-bed awake HR before onset, sleep-onset HR (first 10 min), lowest HR and when it happened, average sleeping HR, per-stage HR, and first- vs second-half HR. Pair with whoop_recovery for RHR/HRV/respiratory rate.",
+    { date: z.iso.date().optional() },
+    async ({ date }) => {
+      const d = date ?? todayIso();
+      const raw = await client.get("/home-service/v1/deep-dive/sleep/last-night", { date: d });
+      return { content: [{ type: "text", text: jsonOut(projectSleepHr(raw, d)) }] };
+    },
+  );
+}
diff --git a/tests/projections/sleep_hr.test.ts b/tests/projections/sleep_hr.test.ts
new file mode 100644
index 0000000..551b7a1
--- /dev/null
+++ b/tests/projections/sleep_hr.test.ts
@@ -0,0 +1,26 @@
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { projectSleepHr } from "../../src/projections/sleep_hr.js";
+import { projectSleep } from "../../src/projections/sleep.js";
+
+const raw = JSON.parse(readFileSync(new URL("../fixtures/deep_dive_sleep.json", import.meta.url), "utf8"));
+
+describe("projectSleepHr", () => {
+  const out = projectSleepHr(raw, "2026-05-23");
+  it("agrees with whoop_sleep's min HR", () => {
+    expect(out.lowest_hr_bpm).toBe(projectSleep(raw, "2026-05-23").sleep_hr.min_bpm);
+  });
+  it("derives onset, nadir time and stage means inside the window", () => {
+    expect(out.points).toBeGreaterThan(100);
+    expect(out.sleep_onset_hr_bpm).not.toBeNull();
+    expect(out.avg_sleeping_hr_bpm).not.toBeNull();
+    const t = Date.parse(out.lowest_hr_at!);
+    expect(t).toBeGreaterThanOrEqual(Date.parse(out.started_at!) - 3600e3);
+    expect(t).toBeLessThanOrEqual(Date.parse(out.ended_at!) + 3600e3);
+    expect(out.lowest_hr_pct_into_sleep).toBeGreaterThanOrEqual(0);
+    expect(out.lowest_hr_pct_into_sleep).toBeLessThanOrEqual(100);
+  });
+  it("returns nulls, not guesses, on an empty response", () => {
+    expect(projectSleepHr({}, "2026-05-23").lowest_hr_bpm).toBeNull();
+  });
+});
